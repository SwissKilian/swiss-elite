{
  "name": "swiss-elite",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "bun run --filter '@swisselite/web' build",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "repo-checks": "node scripts/ci/repo-checks.mjs",
    "audit": "bun audit --prod",
    "format": "prettier --write .",
    "checks": "bun run test && bun run lint && bun run typecheck && bun run repo-checks && bun run audit && bun run build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.7",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.0"
  }
}
